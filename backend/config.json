  "permissions": {
    "bash": {
      "default": "deny",
      "deny": [
        {
          "id": "deny-system-destructive",
          "description": "阻止提权、关机、磁盘和系统级破坏命令",
          "patterns": [
            "\\b(?:sudo|shutdown|reboot|mkfs(?:\\.\\w+)?|diskpart|bcdedit)\\b",
            "\\b(?:format|fdisk|parted)\\b",
            "\\bdd\\s+if=",
            "rm\\s+-[^\\r\\n]*r[^\\r\\n]*f\\s+(?:/|~|\\*)",
            "\\b(?:reg|sc)\\s+delete\\b"
          ]
        },
        {
          "id": "deny-workspace-escape",
          "description": "阻止命令访问 backend/tmp 会话目录之外的本地路径",
          "patterns": [
            "(?:^|[\\s'\\\"])(?:\\.\\.[\\\\/])",
            "(?:^|[\\s'\\\"])[A-Za-z]:[\\\\/]",
            "(?:^|[\\s'\\\"])/(?:etc|home|root|usr|var|opt|proc|sys|dev)(?:[\\\\/\\s'\\\"]|$)",
            "%(?:USERPROFILE|APPDATA|LOCALAPPDATA|SYSTEMROOT|WINDIR)%",
            "\\$(?:HOME|USERPROFILE|APPDATA|SYSTEMROOT|WINDIR)\\b"
          ]
        },
        {
          "id": "deny-shell-escalation",
          "description": "阻止下载后直接执行、策略绕过和危险权限修改",
          "patterns": [
            "\\bchmod\\s+777\\b",
            "\\bset-executionpolicy\\b",
            "\\b(?:curl|wget|iwr|invoke-webrequest)\\b[^\\r\\n|]*\\|\\s*(?:sh|bash|pwsh|powershell)\\b"
          ]
        },
        {
          "id": "deny-opencli-high-risk",
          "description": "阻止 OpenCLI 删除、上传、任意代码执行和插件安装等高风险操作",
          "patterns": [
            "^opencli\\b[^\\r\\n]*\\b(?:delete|archive|upload|eval|auto-approve)\\b",
            "^opencli\\s+(?:plugin|external)\\b[^\\r\\n]*\\b(?:install|register)\\b",
            "^opencli\\s+daemon\\b[^\\r\\n]*(?:0\\.0\\.0\\.0|--public)\\b",
            "^opencli\\b[^\\r\\n]*\\b(?:delete|remove|archive|upload|eval|auto-approve|approve)\\b",
            "^opencli\\s+plugin\\b[^\\r\\n]*\\b(?:install|update|uninstall)\\b",
            "^opencli\\s+external\\b[^\\r\\n]*\\b(?:install|register)\\b"
          ]
        }
      ],
      "allow": [
        {
          "id": "allow-tmp-development",
          "description": "允许在当前 backend/tmp 会话目录内进行常见开发、查询和 OpenCLI 操作",
          "patterns": [
            "^(?:python|python3|py|node|npm|npx|opencli|git|rg|dir|type|echo|where|pdftotext|pdfinfo)\\b",
            "^(?:get-childitem|get-content|set-content|test-path|select-string|copy-item|new-item)\\b",
            "^(?:python|python3|py|node|npm|npx|opencli|git|rg|grep|dir|type|echo|where|mkdir|uv|pytest|ruff|mypy|radon|pip-audit|cargo|pdftotext|pdfinfo|pandoc|wkhtmltopdf|qpdf|mutool|ffmpeg|tesseract)\\b",
            "^(?:get-childitem|get-content|set-content|test-path|select-string|copy-item|new-item|get-command|measure-object)\\b"
          ]
        }
      ],
      "authorize": [
        {
          "id": "authorize-opencli-external-write",
          "description": "OpenCLI 登录、发帖、发送和浏览器交互仅在用户明确要求该副作用时执行",
          "patterns": [
            "^opencli\\b[^\\r\\n]*\\b(?:login|refresh|post|send|follow|create|purchase)\\b",
            "^opencli\\s+browser\\b[^\\r\\n]*\\b(?:click|type|fill|press|select|check|uncheck|drag|submit)\\b",
            "^opencli\\b[^\\r\\n]*\\b(?:login|refresh|post|send|message|follow|unfollow|like|unlike|favorite|unfavorite|subscribe|unsubscribe|comment|create|purchase|pay|order|generate|rename|pin|model)\\b",
            "^opencli\\s+(?:adapter|profile|daemon)\\b[^\\r\\n]*\\b(?:eject|reset|rename|use|stop|restart)\\b"
          ]
        }
      ]
    }
  },
