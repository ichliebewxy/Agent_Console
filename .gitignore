# Secrets: keep the shareable template, never real credentials or backups.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Application state, user data, generated files, and cleanup backups.
/tmp/*
!/tmp/.gitkeep
/data/
/volumes/
/extracted_images/
/backend/tmp/
/backend/data/
/.tmp*/
.pi/agent/
.pi/npm/
.pi/git/

# Node dependencies, builds, tests, and package-manager caches.
node_modules/
dist/
build/
coverage/
.nyc_output/
.cache/
.parcel-cache/
*.tsbuildinfo
.npm/
.pnpm-store/

# Python environments, bytecode, test/lint caches, and packaging outputs.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/
wheels/

# Logs, editors, and operating-system metadata.
*.log
*.log.*
*.swp
*.swo
*~
.idea/
.vs/
.DS_Store
Thumbs.db
Desktop.ini

# package-lock.json and uv.lock are intentionally versioned.
