# ===== Chat model =====
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com
GRADE_MODEL=deepseek-v4-flash
QUERY_EXPANSION_MODEL=deepseek-v4-flash
AGENT_TOOL_CALL_LIMIT=250
# Plan-and-Execute：先规划拆解，再逐步执行，并结合结果反省调整计划
PLAN_EXECUTE_ENABLED=true
PLAN_EXECUTE_MAX_STEPS=6
PLAN_EXECUTE_RESULT_MAX_CHARS=3000

# ===== DashScope MCP (AMap/Gaode tools only) =====
DASHSCOPE_MCP_API_KEY=
MCP_DISCOVERY_TIMEOUT=30

# ===== BGE embeddings =====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
# 置为 true 时只从本地 HF 缓存加载，绝不联网下载（先运行 backend/preload_embedding_model.py）
EMBEDDING_LOCAL_FILES_ONLY=false
BM25_STATE_PATH=

# ===== Rerank =====
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BINDING_HOST=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=embeddings_bge_m3
MILVUS_DENSE_DIM=1024

# ===== Optional OpenCLI browser automation =====
OPENCLI_BIN=
OPENCLI_SESSION=lcagent
OPENCLI_TIMEOUT=75
OPENCLI_OUTPUT_MAX_CHARS=12000

# ===== Skills specialist workspace =====
# Relative paths are resolved from the project root.
BACKEND_TMP_DIR=backend/tmp
AGENT_SKILLS_DIR=agent_workspace/skills
SKILL_CATALOG_MAX_CHARS=8000
SKILL_CONTENT_MAX_CHARS=60000
WORKSPACE_FILE_MAX_CHARS=50000
# Set a long random value in production. If empty, a local key is generated.
ARTIFACT_SIGNING_KEY=

# ===== Local execution in backend/tmp =====
LOCAL_RUN_TIMEOUT=120
LOCAL_RUN_OUTPUT_MAX_CHARS=20000
LOCAL_RUN_COMMAND_MAX_CHARS=8000

# ===== mem0 长期记忆（本地化）=====
# 是否启用长期记忆。关闭后 Agent 不再检索/写入记忆。
MEMORY_ENABLED=true
# 本地记忆数据目录（相对项目根；Qdrant 向量库 + SQLite 历史库）
MEM0_DIR=data/mem0
# 用于 mem0 事实抽取的对话模型（默认复用 CHAT_MODEL）
# MEM0_MODEL=deepseek-v4-flash
# 每轮对话注入上下文的记忆条数上限
MEM0_TOP_K=5
